        // Relations with people and external systems, plus the system and container level arrows the Context and
        // Containers views need (!impliedRelationships is false, so they are not derived).
        // Component to component arrows are generated by `esqueleto.py renderizar` into relacoes-componentes.dsl.
        // Format: origin -> destination "verb in the present tense" "technology" "OptionalTag"

        // Context (system level)
        devApp -> sistema "Installs and calls to send HTTP requests" "npm package, JavaScript API"
        sistema -> nodeRuntime "Opens HTTP, HTTP/2 and TLS connections through" "Node.js http, https, http2"
        sistema -> browserXhr "Sends browser requests through" "XMLHttpRequest"
        sistema -> fetchApi "Sends requests and streams bodies through" "fetch"
        sistema -> proxyServer "Routes requests through, when configured" "HTTP proxy"
        nodeRuntime -> remoteServer "Carries the request and response to and from" "HTTP/1.1, HTTP/2, TLS"
        browserXhr -> remoteServer "Carries the request and response to and from" "HTTP, CORS"
        fetchApi -> remoteServer "Carries the request and response to and from" "HTTP, CORS"
        proxyServer -> remoteServer "Forwards the request to" "HTTP proxy"

        // Containers
        devApp -> axiosLib "Imports and calls in its own process" "ES module, CommonJS or UMD"
        axiosLib -> nodeRuntime "Drives the http, https, http2, zlib and stream modules of" "Node.js APIs"
        axiosLib -> browserXhr "Sends and aborts requests with" "XMLHttpRequest"
        axiosLib -> fetchApi "Sends requests and streams bodies with" "fetch"
        axiosLib -> proxyServer "Routes requests through, when configured" "HTTP proxy"

        // Components with people and external systems
        devApp -> libAxios "Calls axios(), axios.get() and the instance methods of" "JavaScript API"
        adaptersHttp -> nodeRuntime "Sends requests over http, https and http2 sockets of" "Node.js http, https, http2"
        adaptersHttp -> proxyServer "Routes requests through, when configured or set in the environment" "proxy-from-env, https-proxy-agent"
        helpersHttp2Sessions -> nodeRuntime "Opens and keeps HTTP/2 sessions with" "Node.js http2"
        adaptersXhr -> browserXhr "Sends the request and listens for progress and abort events of" "XMLHttpRequest"
        adaptersFetch -> fetchApi "Sends the request and reads the streamed response of" "fetch, Request, Response"

        !include relacoes-componentes.dsl
